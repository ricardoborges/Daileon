# Configuração da Integração com o GitLab API
GITLAB_URL=https://gitlab.com
GITLAB_READ_TOKEN=glpat-your-personal-access-token
GITLAB_GROUP_ID=

# Configuração do Banco de Dados (Opcional - default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/daileon.db

# Destino do proxy /api do frontend (SvelteKit -> FastAPI).
# Em Docker Compose use o hostname do serviço: http://backend:8000
API_URL=http://localhost:8000